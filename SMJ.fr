(* ************************** *)
(* *****  Information   ***** *)
(* ************************** *)

M$ModelName = "Modelo estandar";

M$Information = {
    Authors      -> {"Josias torre Campos"},
    Version      -> "1.00",
    Date         -> "01. 08. 2026",
    Institutions -> {"Universidad Nacional de Ingenieria"},
    Emails       -> {"josias.torre.c@uni.pe"}
};

FeynmanGauge = False; (*configura el gauge de 't Hooft–Feynman (ξ=1), que es el estándar para cálculos perturbativos a varios loops porque simplifica los propagadores y permite un tratamiento sistemático de los bosones de Goldstone y fantasmas.*)

(* ************************** *)
(* ***** NLO Variables ****** *)
(******************************)

FR$LoopSwitches = {{Gf,MW}}; (*Fija que Gf y MW son parámetros de entrada independientes en bucles de simplificación*)
FR$RmDblExt = {ymb -> MB, ymc -> MC, ymdo -> MD, yme -> Me, ymm -> MMU, yms -> MS, ymt -> MT, ymtau -> MTA, ymup -> MU};(*Sustituye acoplamientos de Yukawa por masas físicas de fermiones*)

(* ************************** *)
(* *****      vevs      ***** *)
(* ************************** *)

M$vevs = {{Phi[2],vev}}; (*Le dice al paquete que el campo Phi[2] (el Higgs neutro) tiene un VEV llamado vev, lo cual es esencial para generar masas*)

(* ************************** *)
(* *****  Gauge groups  ***** *)
(* ************************** *)

M$GaugeGroups ={

    U1Y == {
        Abelian          -> True, (*Le decimos que es un grupo Abeliano*)
        CouplingConstant -> g1,   (*La constante de acoplamiento asociada*)
        GaugeBoson       -> B,    (*El boson de gauge asociado*)
        Charge           -> Y     (*La hipercarga asociada*)
    },
    SU2L == {
        Abelian           -> False,     (*Le decimos que no es un grupo abeliano*)
        CouplingConstant  -> gw,        (*La constante de acoplamiento*)
        GaugeBoson        -> Wi,        (*FeynRules lo reconose como un vector de 3 componentes (w[1],w[2],w[3]) esto lo hace porque automaticamento lo calcula la dimencion como (N²-1) *)
        StructureConstant -> Eps,       (*Es el termino de Levi-Civita*)
        Representations   -> {Ta,SU2D}, (*Se mencina que Ta es el generador y ademas SU2D es el nombre que se le da a una representación fundamental del grupo SU(2), sirve como una etiqueta y para definir particulas*)
        Definitions       -> {Ta[a_,b_,c_] -> PauliSigma[a,b,c]/2, FSU2L[i_,j_,k_] :> I Eps[i,j,k]} (*Definiciones de los generadores y la constante de estructura*)
    },
    SU3C == {
        Abelian           -> False,      (* Los gluones interactúan entre sí *)
        CouplingConstant  -> gs,         (* Es la constante de acoplamiento fuerte de QCD *)
        GaugeBoson        -> G,          (* Los campos G con i = 1, ..., 8 son los 8 gluones *)
        StructureConstant -> f,          (* f es la constante de estructura de SU(3) (los famosos f^{abc}) *)
        Representations   -> {T,Colour}, (* T es el generador de de matrices de Gell-Mann, Colour es la representacion fundamental en 3 dimenciones *)
        SymmetricTensor   -> dSUN        (* dSUN es el tensor simétrico de SU(3) (d^{abc}) *)
    }
};
        (* ******************************************************************************************************************************* *)
        (* *** FeynRules tiene definiciones internas para SU(3) (no las ves en el archivo .fr porque son parte del núcleo del paquete) *** *)
        (* *** Generadores de SU(3) - matrices de Gell-Mann                                                                            *** *)
        (* *** T[a_, b_, c_] := GellMann[a,b,c]/2                                                                                      *** *)
        (* *** Constante de estructura f^{abc}                                                                                         *** *)
        (* *** f[a_, b_, c_] := SU3StructureConstant[a,b,c] Tensor simétrico d^{abc}                                                   *** *)
        (* *** dSUN[a_, b_, c_] := SU3SymmetricTensor[a,b,c]                                                                           *** *)   
        (********************************************************************************************************************************* *)

(* ************************** *)
(* *****    Indices     ***** *)
(* ************************** *)

IndexRange[Index[SU2W      ]] = Unfold[Range[3]];(*El índice del grupo SU(2) débil (los bosones Wi) = Toma valores {1, 2, 3} y los despliega explícitamente en los cálculos*)
IndexRange[Index[SU2D      ]] = Unfold[Range[2]];(*El índice de la representación fundamental de SU(2) (dobletes) = Toma valores {1, 2} (las 2 componentes de un doblete)*)
IndexRange[Index[Gluon     ]] = NoUnfold[Range[8]]; (*El índice de los gluones (los bosones de SU(3)C)=Toma valores {1, ..., 8} pero NO se despliega explícitamente*)
IndexRange[Index[Colour    ]] = NoUnfold[Range[3]]; (*El índice de la representación fundamental de SU(3) (color de quarks) = Toma valores {1, 2, 3} (los 3 colores) pero NO se despliega*)
IndexRange[Index[Generation]] = Unfold[Range[3]];

IndexStyle[SU2W,       j]; (*Es el indice que va a representar a SU2W en la salida ya sea en los diagramas de Feynman, etc*)
IndexStyle[SU2D,       k]; (*Es el indice que va a representar a SU2W en la salida ya sea en los diagramas de Feynman, etc*)
IndexStyle[Gluon,      a]; (*Es el indice que va a representar a SU2W en la salida ya sea en los diagramas de Feynman, etc*)
IndexStyle[Colour,     m]; (*Es el indice que va a representar a SU2W en la salida ya sea en los diagramas de Feynman, etc*)
IndexStyle[Generation, f]; (*Es el indice que va a representar a SU2W en la salida ya sea en los diagramas de Feynman, etc*)

(* ************************** *)
(* *** Interaction orders *** *)
(* ***  (as used by mg5)  *** *)
(* ************************** *)

M$InteractionOrderHierarchy = { (*Cuando tengas que hacer una expansión en potencias de las constantes de acoplamiento, trata QCD como orden 1 y QED como orden 2*)
    {QCD,1},
    {QED,2}
};

(* ************************** *)
(* **** Particle classes **** *)
(* ************************** *)
M$ClassesDescription = {

(* Gauge bosons: physical vector fields *)
  V[1] == { (*Tipo de partícula: V = vector (spin-1), [1] es un identificador interno*)
    ClassName       -> A,       (*Nombre simbólico que usará FeynRules internamente (el campo A_μ)*)
    SelfConjugate   -> True,    (*NLa partícula es su propia antipartícula (el fotón es neutro)*)
    Mass            -> 0,       (*El fotón es sin masa*)
    Width           -> 0,       (*El fotón es estable (no tiene ancho de desintegración)*)
    ParticleName    -> "a",     (*Nombre externo para la salida (ej: en gráficos de Feynman se etiqueta como a)*)
    PDG             -> 22,      (*Número PDG del fotón (el estándar internacional)*)
    PropagatorLabel -> "a",     (*Etiqueta para el propagador en los diagramas*)
    PropagatorType  -> W,       (*Tipo de propagador: W = bosón vectorial sin masa (gauge de Feynman)*)
    PropagatorArrow -> None,    (*El fotón no tiene flecha (no distingue partícula/antipartícula)*)
    FullName        -> "Photon" (*Nombre completo para salida legible (ej: en LaTeX)*)
  },
  V[2] == { 
    ClassName       -> Z, 
    SelfConjugate   -> True,
    Mass            -> {MZ, 91.1876},
    Width           -> {WZ, 2.4952},
    ParticleName    -> "Z", 
    PDG             -> 23, 
    PropagatorLabel -> "Z",
    PropagatorType  -> Sine,         (*Tipo de propagador: Sine = bosón vectorial masivo (con forma de Breit-Wigner)*)
    PropagatorArrow -> None,
    FullName        -> "Z"
  },
  V[3] == {
    ClassName        -> W,
    SelfConjugate    -> False,           (*NO es su propia antipartícula (tiene carga eléctrica)*)
    Mass             -> {MW, Internal},  (*Masa: MW es el símbolo, Internal significa que se calculará internamente a partir de otros parámetros*)
    Width            -> {WW, 2.085},     (*Ancho: WW es el símbolo, 2.085 GeV es el valor numérico*)
    ParticleName     -> "W+",            (*Nombre de la partícula (W positivo)*)
    AntiParticleName -> "W-",            (*Nombre de la antipartícula (W negativo)*)
    QuantumNumbers   -> {Q -> 1},        (*Número cuántico: carga eléctrica Q = +1 para el W+*)
    PDG              -> 24, 
    PropagatorLabel  -> "W",
    PropagatorType   -> Sine,
    PropagatorArrow  -> Forward,         (*El propagador tiene flecha hacia adelante*)
    FullName         -> "W"
  },
  V[4] == {
    ClassName        -> G,
    SelfConjugate    -> True,
    Indices          -> {Index[Gluon]},  (*El gluón tiene un índice de color que recorre {1, ..., 8}*)
    Mass             -> 0,
    Width            -> 0,
    ParticleName     -> "g", 
    PDG              -> 21,
    PropagatorLabel  -> "G",
    PropagatorType   -> C,               (*C es un tipo especial de propagador que FeynArts usa para: Gluones y Fantasmas de Faddeev-Popov (necesarios para cancelar grados de libertad no físicos).*)
    PropagatorArrow  -> None,
    FullName         -> "G"
  },

(* Ghosts: related to physical gauge bosons *)
  U[1] == {                                  (*U indica que es un fantasma (partícula no física). [1] es un identificador único dentro de la lista de partículas.*)
    ClassName       -> ghA,                  (*ghA significa "ghost of the Photon" (fantasma del fotón). Este nombre aparecerá en las reglas de Feynman y en el lagrangiano*)
    SelfConjugate   -> False,                (*El fantasma no es su propia antipartícula. Esto es porque tiene número de fantasma (GhostNumber = 1). La antipartícula tendría GhostNumber = -1 y se llama ghA también (porque se definirá automáticamente como la antipartícula).*)
    Ghost           -> A,                    (*Esto le dice a FeynRules:"Este fantasma está asociado al campo A (el fotón)."Consecuencia: FeynRules usará la misma constante de acoplamiento y las mismas reglas de transformación que el fotón para generar los vértices de este fantasma.*)
    QuantumNumbers  -> {GhostNumber -> 1},   (*Define el número cuántico interno del fantasma. GhostNumber -> 1 significa que tiene número de fantasma +1.*)
    Mass            -> 0,                    (*El fantasma del fotón es sin masa, igual que el fotón*)
    Width	        -> 0,                    (*El fantasma es estable (no se desintegra)*)
    PropagatorLabel -> "uA",                 (*Etiqueta para el propagador en la salida gráfica. "u" es la convención para fantasmas en FeynArts."A" indica que está asociado al fotón.*)
    PropagatorType  -> GhostDash,            (*GhostDash es el propagador para fantasmas en el gauge de Feynman.*)
    PropagatorArrow -> Forward               (*os fantasmas tienen número de fantasma que se conserva, por lo que la dirección importa (distingue fantasmas de antifantasmas).*)
  },
  U[2] == {
    ClassName       -> ghZ,
    SelfConjugate   -> False,
    Ghost           -> Z,
    QuantumNumbers  -> {GhostNumber -> 1},
    Mass            -> {MZ,91.1876},        (*El fantasma del Z tiene la misma masa que el Z (91.1876 GeV).*)
    Width	        -> {WZ, 2.4952},
    PropagatorLabel -> "uZ",
    PropagatorType  -> GhostDash,
    PropagatorArrow -> Forward
  },
  U[31] == { 
    ClassName       -> ghWp,
    SelfConjugate   -> False, 
    Ghost           -> W,                           (* Esto le dice a FeynRules:"Este fantasma está asociado al campo W (el W+)*)
    QuantumNumbers  -> {GhostNumber -> 1, Q -> 1},  (*Define los números cuánticos del fantasma:- GhostNumber -> 1: número de fantasma +1.- Q -> 1: carga eléctrica +1 (como el W+).*)
    Mass            -> {MW,Internal}, 
    Width           -> {WW, 2.085}, 
    PropagatorLabel -> "uWp",
    PropagatorType  -> GhostDash, 
    PropagatorArrow -> Forward
  },
  U[32] == { 
    ClassName       -> ghWm,
    SelfConjugate   -> False, 
    Ghost           -> Wbar,
    QuantumNumbers  -> {GhostNumber -> 1, Q -> -1},
    Mass            -> {MW,Internal}, 
    Width           -> {WW, 2.085},
    PropagatorLabel -> "uWm",
    PropagatorType  -> GhostDash, 
    PropagatorArrow -> Forward
  },
  U[4] == { 
    ClassName       -> ghG, 
    SelfConjugate   -> False,              (*Tiene número de fantasma +1, por lo que su antipartícula tendría GhostNumber -> -1.*)
    Indices         -> {Index[Gluon]},     (*Esto significa que hay 8 fantasmas de gluones (ghG[1], ..., ghG[8]). *)
    Ghost           -> G,
    PDG             -> 82,
    QuantumNumbers  ->{GhostNumber -> 1},  (*Número de fantasma +1. Se conserva en los vértices.*)
    Mass            -> 0,
    Width	        -> 0,
    PropagatorLabel -> "uG",
    PropagatorType  -> GhostDash,
    PropagatorArrow -> Forward
  },


(* Gauge bosons: unphysical vector fields *)
  V[11] == { 
    ClassName     -> B, 
    Unphysical    -> True, (*Le decimos que esto no se detecta en el detector*)
    SelfConjugate -> True, 
    Definitions   -> { B[mu_] -> -sw Z[mu]+cw A[mu]} (*Definimos el campo B en términos de los campos físicos Z y A*)
  },
  V[12] == { 
    ClassName     -> Wi, (*Es el nombre que maneja Mathematical en el entorno de FeynRules para operar con los campos Lagrangianos*)
    Unphysical    -> True, (*Le decimos que esto no se detecta en el detector*)
    SelfConjugate -> True, (*Le decimos que esto es su propio conjugado*)
    Indices       -> {Index[SU2W]}, (*Le indicas a Mathematica que Wi es un indice que toma 3 valores posibles*)
    FlavorIndex   -> SU2W,  (*Le indica a FeynRules que este es un indice interno y debe desenrrollar para los calculos*)
    Definitions   -> { Wi[mu_,1] -> (Wbar[mu]+W[mu])/Sqrt[2], Wi[mu_,2] -> (Wbar[mu]-W[mu])/(I*Sqrt[2]), Wi[mu_,3] -> cw Z[mu] + sw A[mu]} (*Definiciones de los campos wi*)
  },

(* Ghosts: related to unphysical gauge bosons *)
  U[11] == {
    ClassName     -> ghB, 
    Unphysical    -> True, (*Le decimos que esto no se detecta en el detector*)
    SelfConjugate -> False, (*es obligatorio para ghB (U[11]) porque todos los fantasmas de Faddeev-Popov son campos escalares de Grassmann complejos*)
    Ghost         -> B, (*le indica explícitamente a FeynRules que el campo fantasma ghB es el socio de Faddeev-Popov del bosón de gauge B (el bosón de hipercarga $B_\mu$).*)
    Definitions   -> { ghB -> -sw ghZ + cw ghA} (*Se transforma similar a su campo asociado B*)
  },
  U[12] == {
    ClassName     -> ghWi,
    Unphysical    -> True, (*Le decimos que esto no se detecta en el detector*)
    SelfConjugate -> False, (*es obligatorio para ghWi (U[12]) porque todos los fantasmas de Faddeev-Popov son campos escalares de Grassmann complejos*)
    Ghost         -> Wi,
    Indices       -> {Index[SU2W]},
    FlavorIndex   -> SU2W,
    Definitions   -> { ghWi[1] -> (ghWp+ghWm)/Sqrt[2], ghWi[2] -> (ghWm-ghWp)/(I*Sqrt[2]), ghWi[3] -> cw ghZ+sw ghA} (*La definicion es similar a sus bosones asociados*)
  },

(* Fermions: physical fields *)
  F[1] == {
    ClassName        -> vl, (*Nombre simbólico global en Mathematica para representar a la familia completa de los neutrinos leptónicos.*)
    ClassMembers     -> {ve,vm,vt}, (*Nombres individuales en Mathematica para cada miembro de la familia: $\nu_e$, $\nu_\mu$ y $\nu_\tau$.*)
    Indices          -> {Index[Generation]}, (*indica que la entidad posee un índice de espacio interno correspondiente a las tres generaciones de materia.*)
    FlavorIndex      -> Generation,(*Marca la generación (1 a 3) como el índice activo sobre el cual operan las matrices de sabor y acoplamientos.*)
    SelfConjugate    -> False, (*Define a los neutrinos como fermiones de Dirac (distintos de sus antipartículas $\bar{\nu}$)*)
    Mass             -> 0, (*Fija la masa en cero exacto ($m_\nu = 0$), la aproximación del Modelo Estándar minimalista sin masa para neutrinos.*)
    Width            -> 0, (*Anchura de desintegración nula ($\Gamma = 0$), ya que al ser los fermiones más livianos no pueden desintegrarse en partículas más ligeras.*)
    QuantumNumbers   -> {LeptonNumber -> 1}, (*Asigna una carga guardada de número leptónico $L = +1$ (sus antipartículas reciben $L = -1$).*)
    PropagatorLabel  -> {"v", "ve", "vm", "vt"} , (*Etiquetas impresas en diagramas LaTeX: la primera es genérica y las siguientes corresponden a cada sabor.*)
    PropagatorType   -> S, (*Define el estilo visual del propagador como S (Straight), una línea continua recta propia de los fermiones.*)
    PropagatorArrow  -> Forward, (*Añade una flecha orientada en la dirección del flujo del número leptónico para diferenciar partículas de antipartículas.*)
    PDG              -> {12,14,16}, (*Identificadores numéricos del Particle Data Group ($\nu_e = 12$, $\nu_\mu = 14$, $\nu_\tau = 16$).*)
    ParticleName     -> {"ve","vm","vt"},(*Nombres en formato string exportados para generadores de eventos como MadGraph.*)
    AntiParticleName -> {"ve~","vm~","vt~"},(*Cadenas de texto que identifican a los antineutrinos en los archivos de salida.*)
    FullName         -> {"Electron-neutrino", "Mu-neutrino", "Tau-neutrino"} (*Nombres descriptivos completos para documentación interna.*)
  },
  F[2] == {  (*Identificador de la clase fermiónica dedicada a los leptones con carga eléctrica.*)
    ClassName        -> l,
    ClassMembers     -> {e, mu, ta},
    Indices          -> {Index[Generation]},
    FlavorIndex      -> Generation,
    SelfConjugate    -> False,
    Mass             -> {Ml, {Me,5.11*^-4}, {MMU,0.10566}, {MTA,1.777}},
    Width            -> 0, (*establece que la anchura de desintegración ($\Gamma$) de las tres partículas del grupo es cero, lo que equivale a tratar a la partícula como 100% estable *)
    QuantumNumbers   -> {Q -> -1, LeptonNumber -> 1}, (*Define dos cargas conservadas clave: carga eléctrica $Q = -1$ y número leptónico $L = +1$.*)
    PropagatorLabel  -> {"l", "e", "mu", "ta"},
    PropagatorType   -> Straight, (*Tipo de trazo gráfico (línea recta continua) característico de los fermiones cargados.*)
    PropagatorArrow  -> Forward, (*Flecha que indica la dirección del flujo de carga y número leptónico.*)
    PDG              -> {11, 13, 15},
    ParticleName     -> {"e-", "mu-", "ta-"},
    AntiParticleName -> {"e+", "mu+", "ta+"},
    FullName         -> {"Electron", "Muon", "Tau"} 
  },
  F[3] == {  (*Identificador de la clase fermiónica dedicada a los quarks up.F = fermión (spin-1/2)*)
    ClassName        -> uq,
    ClassMembers     -> {u, c, t},
    Indices          -> {Index[Generation], Index[Colour]}, (*Los quarks up tienen dos índices:Index[Generation]: índice de sabor (3 generaciones: 1,2,3).Index[Colour]: índice de color (3 colores: 1,2,3).Consecuencia: Cada quark es una matriz 3×3 de campos.*)
    FlavorIndex      -> Generation, (*El índice Generation es un índice de sabor que debe desenrollarse explícitamente en los cálculos*)
    SelfConjugate    -> False,
    Mass             -> {Mu, {MU, 2.55*^-3}, {MC,1.27}, {MT,172}},
    Width            -> {0, 0, {WT,1.50833649}},
    QuantumNumbers   -> {Q -> 2/3},
    PropagatorLabel  -> {"uq", "u", "c", "t"},
    PropagatorType   -> Straight,
    PropagatorArrow  -> Forward,
    PDG              -> {2, 4, 6}, 
    ParticleName     -> {"u",  "c",  "t" },
    AntiParticleName -> {"u~", "c~", "t~"},
    FullName         -> {"u-quark", "c-quark", "t-quark"}
  },
  F[4] == {
    ClassName        -> dq,
    ClassMembers     -> {d, s, b},
    Indices          -> {Index[Generation], Index[Colour]},
    FlavorIndex      -> Generation,
    SelfConjugate    -> False,
    Mass             -> {Md, {MD,5.04*^-3}, {MS,0.101}, {MB,4.7}},
    Width            -> 0,
    QuantumNumbers   -> {Q -> -1/3},
    PropagatorLabel  -> {"dq", "d", "s", "b"},
    PropagatorType   -> Straight, 
    PropagatorArrow  -> Forward,
    PDG              -> {1,3,5},
    ParticleName     -> {"d",  "s",  "b" },
    AntiParticleName -> {"d~", "s~", "b~"},
    FullName         -> {"d-quark", "s-quark", "b-quark"}
  },

(* Fermions: unphysical fields *)

F[11] == {   (*LL es el campo auxiliar que representa doblete de forma compacta.FeynRules lo usa para Construir el lagrangiano en términos de los dobletes de SU(2)*)
    ClassName        -> LL, (*Nombre simbólico interno para el doblete de leptones zurdos*)
    Unphysical       -> True, (*Le decimos que LL no va ni al principio ni final solo es un artificio para que el lagrangiano sea mas compacto, al final se camvian porsus definiciones*)
    Indices          -> {Index[SU2D], Index[Generation]},
    FlavorIndex      -> SU2D,
    SelfConjugate    -> False,
    QuantumNumbers   -> {Y -> -1/2},  (*Hipercarga débil de los leptones zurdos: Y = -1/2*)
    Definitions      -> { LL[sp1_,1,ff_] :> Module[ {sp2}, ProjM[sp1,sp2] vl[sp2,ff] ], LL[sp1_,2,ff_] :> Module[ {sp2}, ProjM[sp1,sp2] l[sp2,ff]] } (*LL[1, f] = (ν_L)_f ; LL[2, f] = (l_L)_f*)
},
F[12] == { 
    ClassName      -> lR,  (*Nombre simbólico interno para el leptón cargado derecho*)
    Unphysical     -> True, 
    Indices        -> {Index[Generation]},
    FlavorIndex    -> Generation, (*Le dice a FeynRules que el índice Generation es un índice de sabor que debe desenrollarse explícitamente en los cálculos.*)
    SelfConjugate  -> False,
    QuantumNumbers -> {Y -> -1},
    Definitions    -> { lR[sp1_,ff_] :> Module[{sp2}, ProjP[sp1,sp2] l[sp2,ff]] } (*lR = l_R Singlete de SU(2) (derechos)*)
  },
F[13] == { 
    ClassName      -> QL,  (*Nombre simbólico interno para el doblete de quarks zurdos*)
    Unphysical     -> True, 
    Indices        -> {Index[SU2D], Index[Generation], Index[Colour]}, (*QL es un tensor de rango 3 (2×3×3).*)
    FlavorIndex    -> SU2D, (*Le dice a FeynRules que el índice SU2D es un índice de sabor interno que debe desenrollarse explícitamente en los cálculos*)
    SelfConjugate  -> False,
    QuantumNumbers -> {Y -> 1/6},
    Definitions    -> { 
      QL[sp1_,1,ff_,cc_] :> Module[{sp2}, ProjM[sp1,sp2] uq[sp2,ff,cc]], (*QL[spin, 1, f, c] = P_L * uq[spin, f, c]; QL = ( u_L , d'_L ) *) 
      QL[sp1_,2,ff_,cc_] :> Module[{sp2,ff2}, CKM[ff,ff2] ProjM[sp1,sp2] dq[sp2,ff2,cc]] } (*QL[spin, 2, f, c] = Σ_{f'} CKM_{f f'} * P_L * dq[spin, f', c] ; d'_L = CKM * d_L*)
},
F[14] == { 
    ClassName      -> uR, 
    Unphysical     -> True, 
    Indices        -> {Index[Generation], Index[Colour]},
    FlavorIndex    -> Generation,
    SelfConjugate  -> False,
    QuantumNumbers -> {Y -> 2/3},
    Definitions    -> { uR[sp1_,ff_,cc_] :> Module[{sp2}, ProjP[sp1,sp2] uq[sp2,ff,cc]] } (*uR[spin, f, c] = P_R * uq[spin, f, c]*)
},
F[15] == { 
    ClassName      -> dR, 
    Unphysical     -> True, 
    Indices        -> {Index[Generation], Index[Colour]},
    FlavorIndex    -> Generation,
    SelfConjugate  -> False,
    QuantumNumbers -> {Y -> -1/3},
    Definitions    -> { dR[sp1_,ff_,cc_] :> Module[{sp2}, ProjP[sp1,sp2] dq[sp2,ff,cc]] } (*dR[spin, f, c] = P_R * dq[spin, f, c]*)
},


(* Higgs: physical scalars  *)

S[1] == {
    ClassName       -> H,
    SelfConjugate   -> True,
    Mass            -> {MH, 125},
    Width           -> {WH, 0.00407},
    PropagatorLabel -> "H",
    PropagatorType  -> D, (*D es el tipo estándar para partículas escalares (spin-0) en FeynArts. *)
    PropagatorArrow -> None,
    PDG             -> 25,
    ParticleName    -> "H",
    FullName        -> "H"
},

(* Higgs: physical scalars  *)
  S[2] == {
    ClassName       -> G0,             (*Nombre simbólico interno para el Goldstone neutro*)
    SelfConjugate   -> True,
    Goldstone       -> Z,              (*Este Goldstone es el grado de libertad longitudinal que el Z 'se come' para volverse masivo.*)
    Mass            -> {MZ, 91.1876},  
    Width           -> {WZ, 2.4952},
    PropagatorLabel -> "Go",           (*"Go" se usa comúnmente para el Goldstone neutro en FeynArts.*)
    PropagatorType  -> D,
    PropagatorArrow -> None,
    PDG             -> 250,
    ParticleName    -> "G0",
    FullName        -> "G0"
  },
  S[3] == {
    ClassName        -> GP,             (*GP significa "Goldstone Positive"*)
    SelfConjugate    -> False,
    Goldstone        -> W,              (*Este Goldstone es el grado de libertad longitudinal que el W+ 'se come' para volverse masivo.*)
    Mass             -> {MW, Internal},
    QuantumNumbers   -> {Q -> 1},
    Width            -> {WW, 2.085},
    PropagatorLabel  -> "GP",           (*"GP" se usa comúnmente para el Goldstone positivo en FeynArts.*)
    PropagatorType   -> D,
    PropagatorArrow  -> None,
    PDG              -> 251,
    ParticleName     -> "G+",
    AntiParticleName -> "G-",
    FullName         -> "GP"
  },

(* Higgs: unphysical scalars  *)
  S[11] == { 
    ClassName      -> Phi,              (*Representa el doblete completo de Higgs, incluyendo el VEV, el Higgs físico y los Goldstone.*)
    Unphysical     -> True, 
    Indices        -> {Index[SU2D]},
    FlavorIndex    -> SU2D,
    SelfConjugate  -> False,            (*La componente cargada (GP) tiene carga, por lo que su antipartícula es GM*)
    QuantumNumbers -> {Y -> 1/2},
    Definitions    -> { Phi[1] -> -I GP, Phi[2] -> (vev + H + I G0)/Sqrt[2]  } (*Φ = ( Phi[1] , Phi[2] ) = ( -i G+ , (v + H + i G0)/√2 ) "-i" permite la hermiticidad*)
  }
};

(* ************************** *)
(* *****     Gauge      ***** *)
(* *****   Parameters   ***** *)
(* *****   (FeynArts)   ***** *)
(* ************************** *)

GaugeXi[ V[1]  ] = GaugeXi[A];    (*El parámetro de gauge del fotón vectorial y del fantasma del fotón será el mismo que el símbolo general GaugeXi[A]*)
GaugeXi[ V[2]  ] = GaugeXi[Z];
GaugeXi[ V[3]  ] = GaugeXi[W];
GaugeXi[ V[4]  ] = GaugeXi[G];
GaugeXi[ S[1]  ] = 1;             (*Esto fija el parámetro de gauge del Higgs en 1 (Gauge de Feynman)*)
GaugeXi[ S[2]  ] = GaugeXi[Z];
GaugeXi[ S[3]  ] = GaugeXi[W];
GaugeXi[ U[1]  ] = GaugeXi[A];
GaugeXi[ U[2]  ] = GaugeXi[Z];
GaugeXi[ U[31] ] = GaugeXi[W];
GaugeXi[ U[32] ] = GaugeXi[W];
GaugeXi[ U[4]  ] = GaugeXi[G];


(* ************************** *)
(* *****   Parameters   ***** *)
(* ************************** *)

M$Parameters ={

  (*Parametros externos*)
  aEWM1 == { 
    ParameterType    -> External, 
    BlockName        -> SMINPUTS,  (*es el bloque estándar donde van los valores de entrada del Modelo Estándar*)
    OrderBlock       -> 1,         (*Es el número de posición dentro de ese bloque. El "1" es el estándar universal para esta constante*)
    Value            -> 127.9,
    InteractionOrder -> {QED,-2},  (*Es una forma elegante de decirle al programa: "Esta constante es la inversa de una interacción de orden 2"*)
    Description      -> "Inverse of the EW coupling constant at the Z pole" (*Inverso de la constante de acoplamiento electrodébil en el polo Z*)
  },
  Gf == {
    ParameterType    -> External,
    BlockName        -> SMINPUTS,
    OrderBlock       -> 2,
    Value            -> 1.16637*^-5, 
    InteractionOrder -> {QED,2},        (*aparece en diagramas con dos factores de acoplamiento electromagnético*)
    TeX              -> Subscript[G,f], (*Cuando escribas esta constante en una fórmula en LaTeX, escríbela como G_f*)
    Description      -> "Fermi constant"
  },
  aS    == { 
    ParameterType    -> External,
    BlockName        -> SMINPUTS,
    OrderBlock       -> 3,
    Value            -> 0.1184, 
    InteractionOrder -> {QCD,2},                (*indica que aparece en vértices que involucran dos factores de acoplamiento fuerte *)
    TeX              -> Subscript[\[Alpha],s],
    Description      -> "Strong coupling constant at the Z pole" (*Constante de acoplamiento fuerte en el polo Z*)
  },
  ymdo == {
    ParameterType -> External,
    BlockName     -> YUKAWA,
    OrderBlock    -> 1,
    Value         -> 5.04*^-3,
    Description   -> "Down Yukawa mass"
  },
  ymup == {
    ParameterType -> External,
    BlockName     -> YUKAWA,
    OrderBlock    -> 2,
    Value         -> 2.55*^-3,
    Description   -> "Up Yukawa mass"
  },
  yms == {
    ParameterType -> External,
    BlockName     -> YUKAWA,
    OrderBlock    -> 3,
    Value         -> 0.101,
    Description   -> "Strange Yukawa mass"
  },
  ymc == {
    ParameterType -> External,
    BlockName     -> YUKAWA,
    OrderBlock    -> 4,
    Value         -> 1.27,
    Description   -> "Charm Yukawa mass"
  },
  ymb == {
    ParameterType -> External,
    BlockName     -> YUKAWA,
    OrderBlock    -> 5,
    Value         -> 4.7,
    Description   -> "Bottom Yukawa mass"
  },
  ymt == {
    ParameterType -> External,
    BlockName     -> YUKAWA,
    OrderBlock    -> 6,
    Value         -> 172,
    Description   -> "Top Yukawa mass"
  },
  yme == {
    ParameterType -> External,
    BlockName     -> YUKAWA,
    OrderBlock    -> 11,
    Value         -> 5.11*^-4,
    Description   -> "Electron Yukawa mass"
  },
  ymm == {
    ParameterType -> External,
    BlockName     -> YUKAWA,
    OrderBlock    -> 13,
    Value         -> 0.10566,
    Description   -> "Muon Yukawa mass"
  },
  ymtau == {
    ParameterType -> External,
    BlockName     -> YUKAWA,
    OrderBlock    -> 15,
    Value         -> 1.777,
    Description   -> "Tau Yukawa mass"
  },
  cabi == {
    ParameterType -> External,
    BlockName     -> CKMBLOCK,
    OrderBlock    -> 1,
    Value         -> 0.227736,    (*Este número (aproximadamente 0.22) gobierna la probabilidad de que un quark down (abajo) se transforme en un quark up (arriba) a través de la interacción débil (emitiendo un bosón W)*)
    TeX           -> Subscript[\[Theta], c],
    Description   -> "Cabibbo angle"
  },

  (* Internal Parameters *)
  aEW == {
    ParameterType    -> Internal,
    Value            -> 1/aEWM1,
    InteractionOrder -> {QED,2},
    TeX              -> Subscript[\[Alpha], EW],
    Description      -> "Electroweak coupling contant"
  },
  MW == { 
    ParameterType -> Internal, 
    Value         -> Sqrt[MZ^2/2+Sqrt[MZ^4/4-Pi/Sqrt[2]*aEW/Gf*MZ^2]], 
    TeX           -> Subscript[M,W], 
    Description   -> "W mass"
  },
  sw2 == { 
    ParameterType -> Internal, 
    Value         -> 1-(MW/MZ)^2, 
    Description   -> "Squared Sin of the Weinberg angle"
  },
  ee == { 
    ParameterType    -> Internal, 
    Value            -> Sqrt[4 Pi aEW], 
    InteractionOrder -> {QED,1}, 
    TeX              -> e,  
    Description      -> "Electric coupling constant"
  },
  cw == { 
    ParameterType -> Internal, 
    Value         -> Sqrt[1-sw2], 
    TeX           -> Subscript[c,w], 
    Description   -> "Cosine of the Weinberg angle"
  },
  sw == { 
    ParameterType -> Internal, 
    Value         -> Sqrt[sw2], 
    TeX           -> Subscript[s,w], 
    Description   -> "Sine of the Weinberg angle"
  },
  gw == { 
    ParameterType    -> Internal, 
    Definitions      -> {gw->ee/sw}, 
    InteractionOrder -> {QED,1},  
    TeX              -> Subscript[g,w], 
    Description      -> "Weak coupling constant at the Z pole"
  },
  g1 == { 
    ParameterType    -> Internal, 
    Definitions      -> {g1->ee/cw}, 
    InteractionOrder -> {QED,1},  
    TeX              -> Subscript[g,1], 
    Description      -> "U(1)Y coupling constant at the Z pole"
  },
  gs == {   (*Es la constante de acoplamiento fuerte (gs​), el equivalente a la carga eléctrica ee pero para la fuerza nuclear fuerte*)
    ParameterType    -> Internal, 
    Value            -> Sqrt[4 Pi aS], (*similar a la carga ee*)
    InteractionOrder -> {QCD,1},  
    TeX              -> Subscript[g,s], 
    ParameterName    -> G,
    Description      -> "Strong coupling constant at the Z pole"
  },
  vev == {
    ParameterType    -> Internal,
    Value            -> 2*MW*sw/ee, 
    InteractionOrder -> {QED,-1}, (*Es una forma elegante de decirle al programa que esta constante es inversamente proporcional a la carga eléctrica.*)
    Description      -> "Higgs vacuum expectation value"
  },
  lam == {
    ParameterType    -> Internal,
    Value            -> MH^2/(2*vev^2),
    InteractionOrder -> {QED, 2},
    Description      -> "Higgs quartic coupling"
  },
  muH == {
    ParameterType -> Internal,
    Value         -> Sqrt[vev^2 lam],
    TeX           -> \[Mu],
    Description   -> "Coefficient of the quadratic piece of the Higgs potential"
  },
  yl == {   (*Corresponde a la matriz de acoplamientos de Yukawa para los leptones cargados (electrón, muón, tau)*)
    ParameterType    -> Internal,
    Indices          -> {Index[Generation], Index[Generation]},
    Definitions      -> {yl[i_?NumericQ, j_?NumericQ] :> 0  /; (i =!= j)}, (*Esto es una regla de Mathematica. Se lee: "Si i y j son números (índices de generación) y i es diferente de j (i =!= j), entonces el valor de yl[i,j] es 0*)
    Value            -> {yl[1,1] -> Sqrt[2] yme / vev, yl[2,2] -> Sqrt[2] ymm / vev, yl[3,3] -> Sqrt[2] ymtau / vev},
    InteractionOrder -> {QED, 1}, (*El acoplamiento de Yukawa (ylyl​) es proporcional a la carga eléctrica ee (porque vv es inversamente proporcional a ee, y yl∝1/vyl​∝1/v). Por eso su orden en QED es 1*)
    ParameterName    -> {yl[1,1] -> ye, yl[2,2] -> ym, yl[3,3] -> ytau},
    TeX              -> Superscript[y, l], (*Le dice a LaTeX que escriba esta matriz como ylyl (y con superíndice l). La "l" es de leptón.*)
    Description      -> "Lepton Yukawa couplings"
  },
  yu == {
    ParameterType    -> Internal,
    Indices          -> {Index[Generation], Index[Generation]},
    Definitions      -> {yu[i_?NumericQ, j_?NumericQ] :> 0  /; (i =!= j)},
    Value            -> {yu[1,1] -> Sqrt[2] ymup/vev, yu[2,2] -> Sqrt[2] ymc/vev, yu[3,3] -> Sqrt[2] ymt/vev},
    InteractionOrder -> {QED, 1},
    ParameterName    -> {yu[1,1] -> yup, yu[2,2] -> yc, yu[3,3] -> yt},
    TeX              -> Superscript[y, u],
    Description      -> "Up-type Yukawa couplings"
  },
  yd == {
    ParameterType    -> Internal,
    Indices          -> {Index[Generation], Index[Generation]},
    Definitions      -> {yd[i_?NumericQ, j_?NumericQ] :> 0  /; (i =!= j)},
    Value            -> {yd[1,1] -> Sqrt[2] ymdo/vev, yd[2,2] -> Sqrt[2] yms/vev, yd[3,3] -> Sqrt[2] ymb/vev},
    InteractionOrder -> {QED, 1},
    ParameterName    -> {yd[1,1] -> ydo, yd[2,2] -> ys, yd[3,3] -> yb},
    TeX              -> Superscript[y, d],
    Description      -> "Down-type Yukawa couplings"
  },

(* N. B. : only Cabibbo mixing! *)
CKM == {
  ParameterType      -> Internal,
  Indices            -> {Index[Generation], Index[Generation]},
  Unitary            -> True,
  Value              -> { CKM[1,1] -> Cos[cabi],  CKM[1,2] -> Sin[cabi], CKM[1,3] -> 0,
                          CKM[2,1] -> -Sin[cabi], CKM[2,2] -> Cos[cabi], CKM[2,3] -> 0,
                          CKM[3,1] -> 0,          CKM[3,2] -> 0,         CKM[3,3] -> 1 },
  TeX                -> Superscript[V,CKM],
  Description        -> "CKM-Matrix" 
}

};


(* ************************** *)
(* *****   Lagrangian   ***** *)
(* ************************** *)

LGauge    := Block[{mu,nu,ii,aa},
                   ExpandIndices[-1/4 FS[B,mu,nu] FS[B,mu,nu] -1/4 FS[Wi,mu,nu,ii] FS[Wi,mu,nu,ii] -1/4 FS[G,mu,nu,aa] FS[G,mu,nu,aa], FlavorExpand -> SU2W] ];

LFermions := Block[ {mu}, (*Define el Lagrangiano de los fermiones.*)
                   ExpandIndices[I*(QLbar.Ga[mu].DC[QL,mu] + LLbar.Ga[mu].DC[LL,mu] + uRbar.Ga[mu].DC[uR,mu] + dRbar.Ga[mu].DC[dR,mu] + lRbar.Ga[mu].DC[lR,mu]),
                   FlavorExpand -> {SU2W,SU2D}] /.{ CKM[a_,b_] Conjugate[CKM[a_,c_] ] -> IndexDelta[b,c], CKM[b_,a_] Conjugate[CKM[c_,a_] ] ->IndexDelta[b,c] } ]; (*/. { ... }: Es una regla de reemplazo. Después de expandir todo, el código aplica una simplificación matemática*)

LHiggs    := Block[{ii,mu,feynmangaugerules},
                   feynmangaugerules = If[Not[FeynmanGauge], {G0|GP|GPbar} -> 0, {}];
                   ExpandIndices[DC[Phibar[ii],mu] DC[Phi[ii], mu] + muH^2 Phibar[ii] Phi[ii] - lam Phibar[ii] Phi[ii] Phibar[jj] Phi[jj], FlavorExpand -> {SU2D,SU2W}] /.feynmangaugerules
                  ];

LYukawa   := Block[{sp,ii,jj,cc,ff1,ff2,ff3,yuk,feynmangaugerules},
                    feynmangaugerules = If[Not[FeynmanGauge], {G0|GP|GPbar} -> 0, {}];

             yuk = ExpandIndices[
                    -yd[ff2,ff3] CKM[ff1,ff2] QLbar[sp,ii,ff1,cc]. dR[sp,ff3,cc] Phi[ii]-
                     yl[ff1,ff3] LLbar[sp,ii,ff1].lR[sp,ff3]-
                     yu[ff1,ff2] QLbar[sp,ii,ff1,cc].uR[sp,ff2,cc] Phibar[jj] Eps[ii,jj], FlavorExpand -> SU2D
                     ];
             yuk = yuk /. { CKM[a_, b_] Conjugate[CKM[a_, c_]] -> IndexDelta[b, c], CKM[b_, a_] Conjugate[CKM[c_, a_]] -> IndexDelta[b, c]};
             yuk + HC[yuk]/.feynmangaugerules
];


LGhost := Block[{LGh1,LGhw,LGhs,LGhphi,mu, generators,gh,ghbar,Vectorize,phi1,phi2,togoldstones,doublet,doublet0},
  (* Pure gauge piece *) 	
  LGh1 = -ghBbar.del[DC[ghB,mu],mu];
  LGhw = -ghWibar[ii].del[DC[ghWi[ii],mu],mu];
  LGhs = -ghGbar[ii].del[DC[ghG[ii],mu],mu];

  (* Scalar pieces: see Peskin pages 739-742 *)
  (* phi1 and phi2 are the real degrees of freedom of GP *)
  (* Vectorize transforms a doublet in a vector in the phi-basis, i.e. the basis of real degrees of freedom *)
  gh    = {ghB, ghWi[1], ghWi[2], ghWi[3]};
  ghbar = {ghBbar, ghWibar[1], ghWibar[2], ghWibar[3]};
  generators = {-I/2 g1 IdentityMatrix[2], -I/2 gw PauliSigma[1], -I/2 gw PauliSigma[2], -I/2 gw PauliSigma[3]};
  doublet = Expand[{(-I phi1 - phi2)/Sqrt[2], Phi[2]} /. MR$Definitions /. vev -> 0]; 
  doublet0 = {0, vev/Sqrt[2]};
  Vectorize[{a_, b_}]:= Simplify[{Sqrt[2] Re[Expand[a]], Sqrt[2] Im[Expand[a]], Sqrt[2] Re[Expand[b]], Sqrt[2] Im[Expand[b]]}/.{Im[_]->0, Re[num_]->num}];
  togoldstones := {phi1 -> (GP + GPbar)/Sqrt[2], phi2 -> (-GP + GPbar)/(I Sqrt[2])};
  LGhphi=Plus@@Flatten[Table[-ghbar[[kkk]].gh[[lll]] Vectorize[generators[[kkk]].doublet0].Vectorize[generators[[lll]].(doublet+doublet0)],{kkk,4},{lll,4}]] /.togoldstones;

ExpandIndices[ LGhs + If[FeynmanGauge, LGh1 + LGhw + LGhphi,0], FlavorExpand->SU2W]];

LSM:= LGauge + LFermions + LHiggs + LYukawa + LGhost;


